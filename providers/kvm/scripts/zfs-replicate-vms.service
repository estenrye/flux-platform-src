[Unit]
Description=replicate vmpool/vms zvols to TrueNAS
After=network-online.target zfs.target
Wants=network-online.target

[Service]
Type=oneshot
# PING_URL for Healthchecks (0600, root; see docs/runbooks/kvm-host-prep.md).
EnvironmentFile=-/etc/zfs-replicate-vms.env
ExecStart=/usr/local/sbin/zfs-replicate-vms.sh
