    "list": [
      {
        "name": "svc",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoria-metrics"
        },
        "query": {
          "query": "label_values({service_name=~\"flux-state-metrics-kube-state-metrics\"}, service_name)",
          "refId": "svc"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": "flux-state-metrics-kube-state-metrics",
        "current": {
