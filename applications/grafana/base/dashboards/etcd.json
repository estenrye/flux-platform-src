          "expr": "sum by (k8s_node_name) (rate(etcd_network_peer_round_trip_time_seconds_sum{service_name=~\"$svc\"}[5m])) / sum by (k8s_node_name) (rate(etcd_network_peer_round_trip_time_seconds_count{service_name=~\"$svc\"}[5m]))",
          "legendFormat": "",
          "refId": "A"
        }
