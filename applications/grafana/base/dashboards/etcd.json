          "expr": "sum(rate(etcd_server_slow_apply_total{service_name=~\"$svc\"}[5m])) + sum(rate(etcd_server_slow_read_indexes_total{service_name=~\"$svc\"}[5m]))",
          "legendFormat": "",
          "refId": "A"
        }
      ]
