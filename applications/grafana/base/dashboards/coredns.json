          "expr": "sum(rate(coredns_cache_hits_total{service_name=~\"$svc\"}[5m])) / sum(rate(coredns_cache_requests_total{service_name=~\"$svc\"}[5m]))",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
