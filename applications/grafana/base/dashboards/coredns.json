          "expr": "histogram_quantile(0.99, sum by (le) (rate(coredns_kubernetes_dns_programming_duration_seconds_bucket{service_name=~\"$svc\"}[15m])))",
          "legendFormat": "",
          "refId": "A"
        }
      ]
