      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "expr": "sum(rate(coredns_dns_request_duration_seconds_sum{service_name=~\"$svc\"}[5m])) / sum(rate(coredns_dns_request_duration_seconds_count{service_name=~\"$svc\"}[5m]))",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
