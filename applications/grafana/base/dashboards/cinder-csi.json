        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "expr": "sum by (job, instance) (process_open_fds{job=~\"$job\"})",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    }
  ]
}
