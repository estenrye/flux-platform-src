  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Cluster CPU: allocatable vs requested vs used",
      "datasource": {
        "type": "prometheus",
        "uid": "victoria-metrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "expr": "sum(k8s_node_allocatable_cpu)",
          "legendFormat": "allocatable",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "expr": "sum(sum by (namespace, workload, container) (label_replace(label_replace(label_replace(label_replace(label_replace(k8s_container_cpu_request, \"namespace\", \"$1\", \"k8s_namespace_name\", \"(.+)\"), \"pod\", \"$1\", \"k8s_pod_name\", \"(.+)\"), \"container\", \"$1\", \"k8s_container_name\", \"(.+)\"), \"workload\", \"$1\", \"pod\", \"(.+)\"), \"workload\", \"$1\", \"pod\", \"^(.+?)(-[a-z0-9]{8,10}-[a-z0-9]{5}|-[a-z0-9]{5}|-[0-9]+)$\")))",
          "legendFormat": "requested",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "expr": "sum(rate(container_cpu_usage_seconds_total{container!=\"\"}[5m]))",
          "legendFormat": "used",
          "refId": "C"
        }
      ]
    },
    {
