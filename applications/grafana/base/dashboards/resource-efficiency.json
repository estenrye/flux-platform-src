{
  "uid": "core-infra-resource-efficiency",
  "title": "Resource efficiency: allocation vs usage",
  "description": "Requests, limits, usage, throttling and VPA targets for every container.",
  "tags": [
    "core-infra",
    "generated",
    "efficiency"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "5m",
  "templating": {
    "list": [
      {
        "name": "ns",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoria-metrics"
        },
        "query": {
          "query": "label_values(container_cpu_usage_seconds_total, namespace)",
          "refId": "ns"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "window",
        "label": "History",
        "type": "custom",
        "query": "1h,6h,1d,3d,7d,14d",
        "multi": false,
        "includeAll": false,
        "current": {
          "selected": true,
          "text": "7d",
          "value": "7d"
        },
        "options": [
          {
            "text": "1h",
            "value": "1h",
            "selected": false
          },
          {
            "text": "6h",
            "value": "6h",
            "selected": false
          },
          {
            "text": "1d",
            "value": "1d",
            "selected": false
