        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "expr": "sum by (verb) (rate(apiserver_request_total{service_name=~\"$svc\"}[5m]))",
          "legendFormat": "",
          "refId": "A"
